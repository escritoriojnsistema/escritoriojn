{
  "name": "escritorio-jn",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/utils/*.test.ts tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-database.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:team-ui": "node scripts/test-team-ui.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "express": "5.3.0",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0"
}
