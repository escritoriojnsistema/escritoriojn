{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "includeFiles": "server/assets/audit-fonts/**", "maxDuration": 120 } },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|icons(?:/|$)|sw\\.js$|offline\\.html$|manifest\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets(?:/|$)|images(?:/|$)|icons(?:/|$)|offline\\.html$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    },
    {
      "source": "/icons/app-192.png",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    },
    {
      "source": "/icons/app-512.png",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    },
    {
      "source": "/icons/apple-touch-icon.png",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    }
  ]
}
