# Etapa 01 funciona sem .env e sem serviços externos.
# npm run dev: porta 3000; npm run preview: porta 4173.
# Apenas para npm start (API compilada):
HOST=127.0.0.1
PORT=3001
# Banco Supabase versionado na etapa 03; conexão de sessão do app na etapa 04.
# SMTP customizado permanece no painel Supabase; não copiar senha de aplicativo.
# Nunca colocar secret/service_role em VITE_*, código cliente ou Git.

# Etapa 04: somente URL e chave PUBLICÁVEL do projeto (usadas por Vite e API).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Site URL e allowlist de callback ficam em Supabase Auth > URL Configuration.

# Evolução (IA 2 — variáveis exclusivamente server-side na Vercel / Edge Functions; NUNCA usar VITE_*)
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_WEBHOOK_HMAC_SECRET_GENERIC_PSP_PIX_CARD=
PAYMENT_WEBHOOK_HMAC_SECRET_GENERIC_PIX_BANK=
PAYMENT_WEBHOOK_HMAC_SECRET_GENERIC_ACQUIRER_TERMINAL=
PIX_PROVIDER_BASE_URL=
PIX_PROVIDER_CLIENT_ID=
PIX_PROVIDER_CLIENT_SECRET=
CARD_PROVIDER_BASE_URL=
CARD_PROVIDER_API_KEY=
TERMINAL_LOCAL_AGENT_SHARED_SECRET=
PAYMENT_RECONCILIATION_CRON_SECRET=

